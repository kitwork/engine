    "orders": [
      { "id": "DH-1027", "phone": "0912 345 678", "items": "2 × Cà phê sữa, 1 × Bạc xỉu", "total": 90000, "createdAt": "2026-10-11T08:42:00Z", "label": "Đang pha", "tone": "warning" },
      { "id": "DH-1026", "phone": "0987 654 321", "items": "1 × Trà đào", "total": 35000, "createdAt": "2026-10-11T08:31:00Z", "label": "Chờ lấy", "tone": "brand" },
      { "id": "DH-1025", "phone": "0903 111 222", "items": "3 × Bạc xỉu", "total": 96000, "createdAt": "2026-10-11T08:05:00Z", "label": "Đã giao", "tone": "success" }
    ]
  },
  "cases": [
    {
      "name": "menu",
      "route": ".",
      "path": "/",
      "scope": { "user": "@shared.staff", "products": "@shared.products" },
      "expect": "expect/menu.html"
    },
    {
      "name": "menu-guest",
      "route": ".",
      "path": "/",
      "scope": { "user": "@shared.guest", "products": [] },
      "expect": "expect/menu-guest.html"
    },
    {
      "name": "detail",
      "route": "san-pham/{slug[string]}",
      "path": "/san-pham/ca-phe-sua",
      "scope": {
        "user": "@shared.staff",
        "product": "@shared.products[0]",
        "reviews": [
          { "id": "r1", "author": "Lan", "body": "Đậm, thơm, vừa ngọt.", "createdAt": "2026-10-02T08:30:00Z" },
          { "id": "r2", "author": "Minh", "body": "Sữa hơi nhiều <3", "createdAt": "2026-09-28T14:00:00Z" }
        ],
        "faqs": "@shared.faqs",
        "crumbs": "@shared.crumbs",
        "size": "vua",
        "quantity": 1
      },
      "functions": { "total": "product.prices[size] * quantity" },
      "expect": "expect/detail.html"
    },
    {
      "name": "detail-sold-out-no-reviews",
      "route": "san-pham/{slug[string]}",
      "path": "/san-pham/tra-dao",
      "scope": {
        "user": "@shared.staff",
        "product": "@shared.products[2]",
        "reviews": [],
        "faqs": "@shared.faqs",
        "crumbs": "@shared.crumbs",
        "size": "lon",
        "quantity": 2
      },
      "functions": { "total": "product.prices[size] * quantity" },
      "expect": "expect/detail-sold-out-no-reviews.html"
    },
    {
      "name": "about",
      "route": "ve-chung-toi",
      "path": "/ve-chung-toi",
      "scope": {
        "user": "@shared.staff",
        "values": [
          { "id": "hat", "icon": "plant", "title": "Hạt rang mỗi tuần", "body": "Robusta Cầu Đất, rang mộc, không tẩm." },
          { "id": "may", "icon": "coffee", "title": "Pha bằng máy", "body": "Mỗi ly một liều, vị đều từ sáng tới tối." },
          { "id": "gan", "icon": "map-pin", "title": "Ngay góc phố", "body": "Đặt trước trên web, ghé qua là lấy." }
        ]
      },
      "expect": "expect/about.html"
    },
    {
      "name": "app",
      "route": "tai-app",
      "path": "/tai-app",
      "scope": { "user": "@shared.staff" },
      "expect": "expect/app.html"
    },
    {
      "name": "orders-empty",
      "route": "don-hang",
      "path": "/don-hang",
      "scope": { "user": "@shared.staff", "orders": [] },
      "expect": "expect/orders-empty.html"
    },
    {
      "name": "terms",
      "route": "dieu-khoan",
      "path": "/dieu-khoan",
      "scope": {
        "user": "@shared.staff",
        "terms": [
          { "id": "dat", "title": "Đặt món", "body": "Đơn được giữ 30 phút kể từ giờ hẹn lấy. Quá giờ quán pha lại nếu bạn vẫn muốn lấy." },
          { "id": "gia", "title": "Giá", "body": "Giá tính ở quầy theo thực đơn lúc đặt; giá trên giỏ hàng là tạm tính." }
        ]
      },
      "expect": "expect/terms.html"
    },
    {
      "name": "manage",
      "route": "quan-ly",
      "path": "/quan-ly",
      "scope": { "user": "@shared.staff", "orders": "@shared.orders" },
      "expect": "expect/manage.html"
    },
    {
      "name": "not-found",
      "route": ".",
      "path": "/khong-co",
      "notfound": true,
      "scope": { "user": "@shared.staff" },
      "expect": "expect/not-found.html"
    },
    {
      "name": "detail-not-found",
      "route": "san-pham/{slug[string]}",
      "path": "/san-pham/khong-co",
      "notfound": true,
      "scope": { "user": "@shared.staff" },
      "expect": "expect/detail-not-found.html"
    },
    {
      "name": "contrast-brand-text-on-canvas",
      "route": ".",
      "files": {
        "content.ui": "<content><text size=\"mini\" weight=\"bold\" case=\"upper\" color=\"brand\">Thực đơn</text></content>"
      },
      "warnings": [
        { "at": "content.ui:1:55", "says": "color=\"brand\" trên nền canvas chỉ 3.17:1 ở chế độ sáng; chữ thường cần 4.5:1 (chữ lớn 3:1). Dùng color=\"brand+30\" (4.74:1 sáng, 13.23:1 tối). brand+30 là một bậc cho cả hai chế độ: ở chế độ tối nó là #ffcfad, gần trắng, mà tối chỉ cần brand (7.50:1). Muốn giữ sắc ở cả hai chế độ thì khai một vai trò riêng: router.colors({ \"brand.text\": { light: \"#a75700\", dark: \"#d79565\" } }) rồi viết color=\"brand.text\"." }
      ]
    },
    {
      "name": "contrast-brand-text-on-canvas-strict",
      "route": ".",
      "contrast": "strict",
      "files": {
        "content.ui": "<content><text size=\"mini\" weight=\"bold\" case=\"upper\" color=\"brand\">Thực đơn</text></content>"
      },
      "error": { "at": "content.ui:1:55", "says": "color=\"brand\" trên nền canvas chỉ 3.17:1 ở chế độ sáng; chữ thường cần 4.5:1 (chữ lớn 3:1). Dùng color=\"brand+30\" (4.74:1 sáng, 13.23:1 tối). brand+30 là một bậc cho cả hai chế độ: ở chế độ tối nó là #ffcfad, gần trắng, mà tối chỉ cần brand (7.50:1). Muốn giữ sắc ở cả hai chế độ thì khai một vai trò riêng: router.colors({ \"brand.text\": { light: \"#a75700\", dark: \"#d79565\" } }) rồi viết color=\"brand.text\"." }
    }
  ]
}
