const router = { highlight: (theme) => theme };
const theme = router.highlight({ function: { color: "brand" }, default: 1, new: 2, class: 3, if: 4, true: 5, undefined: 6 });
let result = theme.function.color + ":" + (theme.default + theme.new + theme.class + theme.if + theme.true + theme.undefined);
