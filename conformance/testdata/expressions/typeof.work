// typeof gives JavaScript's name of a value's kind (14/10/2026). null gives "undefined": Kitwork has one
// value for null and undefined, so typeof x === "undefined" finds a name or a key that is not there.
const o = { name: "kit", count: 2, list: [], run: () => 1 };
let result = [typeof o.name, typeof o.count, typeof true, typeof o, typeof o.list, typeof o.run,
    typeof o.missing, typeof missing === "undefined", typeof null, typeof typeof 1, typeof 1 + 1];
