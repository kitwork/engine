[
  { "kind": "pairs", "name": "one-pair", "src": "text: total", "want": [["text", "total"]] },
  { "kind": "pairs", "name": "two-pairs", "src": "text: money(total()); show: open", "want": [["text", "money(total())"], ["show", "open"]] },
  { "kind": "pairs", "name": "class-and-aria", "src": "class.done: value == 100; aria-valuenow: value", "want": [["class.done", "value == 100"], ["aria-valuenow", "value"]] },
  { "kind": "pairs", "name": "style-like-css", "src": "width: value + '%'; top: offset()", "want": [["width", "value + '%'"], ["top", "offset()"]] },
  { "kind": "pairs", "name": "custom-property", "src": "--progress: value", "want": [["--progress", "value"]] },
  { "kind": "pairs", "name": "trailing-semicolon", "src": "show: open;", "want": [["show", "open"]] },
  { "kind": "pairs", "name": "whitespace-everywhere", "src": "  text :  x  ;   ;  show:y ", "want": [["text", "x"], ["show", "y"]] },
  { "kind": "pairs", "name": "empty-attribute", "src": "", "want": [] },
  { "kind": "pairs", "name": "only-separators", "src": " ; ; ", "want": [] },
  { "kind": "pairs", "name": "colon-in-ternary-value", "src": "text: open ? 'Đóng' : 'Mở'", "want": [["text", "open ? 'Đóng' : 'Mở'"]] },
  { "kind": "pairs", "name": "semicolon-in-single-quotes", "src": "text: a ? 'x;y' : b; show: c", "want": [["text", "a ? 'x;y' : b"], ["show", "c"]] },
  { "kind": "pairs", "name": "semicolon-in-double-quotes", "src": "text: \"a;b\"", "want": [["text", "\"a;b\""]] },
  { "kind": "pairs", "name": "semicolon-in-backticks", "src": "text: `a;b`", "want": [["text", "`a;b`"]] },
  { "kind": "pairs", "name": "escaped-quote-inside-string", "src": "text: 'it\\'s; fine'; show: x", "want": [["text", "'it\\'s; fine'"], ["show", "x"]] },
  { "kind": "pairs", "name": "semicolon-in-parentheses", "src": "text: f(a; b); show: c", "want": [["text", "f(a; b)"], ["show", "c"]] },
  { "kind": "pairs", "name": "semicolon-in-brackets-and-braces", "src": "text: [1; 2][0]; title: {a: 1}['a']", "want": [["text", "[1; 2][0]"], ["title", "{a: 1}['a']"]] },
  { "kind": "pairs", "name": "event-with-modifiers", "src": "click.debounce(300): search(); keydown.escape: close()", "want": [["click.debounce(300)", "search()"], ["keydown.escape", "close()"]] },
  { "kind": "pairs", "name": "event-key-combination", "src": "keydown.ctrl+k: open()", "want": [["keydown.ctrl+k", "open()"]] },
  { "kind": "pairs", "name": "class-with-alpha-or-glass", "src": "material-glass/60: dark; background-paper/80: open", "want": [["material-glass/60", "dark"], ["background-paper/80", "open"]] },
  { "kind": "pairs", "name": "event-with-hyphen-name", "src": "click-outside: close(); pointer-enter.once: peek()", "want": [["click-outside", "close()"], ["pointer-enter.once", "peek()"]] },
  { "kind": "pairs", "name": "string-with-colon-as-value", "src": "title: 'a: b'", "want": [["title", "'a: b'"]] },
  { "kind": "pairs", "name": "error-no-colon", "src": "text", "error": true },
  { "kind": "pairs", "name": "error-empty-name", "src": ": x", "error": true },
  { "kind": "pairs", "name": "error-empty-value", "src": "text:", "error": true },
  { "kind": "pairs", "name": "error-empty-value-before-next", "src": "text: ; show: y", "error": true },
  { "kind": "pairs", "name": "error-space-in-name", "src": "te xt: a", "error": true },
  { "kind": "pairs", "name": "error-quote-in-name", "src": "'text': a", "error": true },
  { "kind": "pairs", "name": "error-unterminated-quote", "src": "text: 'abc", "error": true },
  { "kind": "pairs", "name": "error-unterminated-parenthesis", "src": "text: f(a; show: b", "error": true },
  { "kind": "pairs", "name": "error-unbalanced-closing", "src": "text: a); show: b", "error": true },

  { "kind": "component", "name": "bare-name", "src": "progressbar", "want": { "name": "progressbar", "alias": "" } },
  { "kind": "component", "name": "name-and-alias", "src": "dropdown: $account", "want": { "name": "dropdown", "alias": "$account" } },
  { "kind": "component", "name": "version-stays-in-name", "src": "theme@1.0.0: $theme", "want": { "name": "theme@1.0.0", "alias": "$theme" } },
  { "kind": "component", "name": "spaces-trimmed", "src": "  toast :  $toast ", "want": { "name": "toast", "alias": "$toast" } },
  { "kind": "component", "name": "error-alias-without-dollar", "src": "dropdown: account", "error": true },
  { "kind": "component", "name": "error-space-in-name", "src": "drop down", "error": true },
  { "kind": "component", "name": "error-empty", "src": "", "error": true },

  { "kind": "for", "name": "item-of-list", "src": "line of items", "want": { "item": "line", "index": "", "list": "items", "key": "" } },
  { "kind": "for", "name": "with-key", "src": "line of items; key: line.id", "want": { "item": "line", "index": "", "list": "items", "key": "line.id" } },
  { "kind": "for", "name": "with-index-and-key", "src": "row, i of rows.slice(0, 3); key: row.id", "want": { "item": "row", "index": "i", "list": "rows.slice(0, 3)", "key": "row.id" } },
  { "kind": "for", "name": "error-no-of", "src": "line in items", "error": true },
  { "kind": "for", "name": "error-unknown-pair", "src": "line of items; track: line.id", "error": true }
]
