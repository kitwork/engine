[
  {
    "name": "Write to nearest owning scope in lexical hierarchy",
    "mode": "action",
    "initialScope": {
      "parent": { "count": 0 },
      "child": { "open": false }
    },
    "expression": "count = count + 1",
    "expectScope": {
      "parent.count": 1,
      "child.open": false
    }
  },
  {
    "name": "Single initialization of data-kit-scope on mount",
    "mode": "mount",
    "scopeAttr": "count: 10; open: false;",
    "actions": [
      "open = true",
      "count = 20"
    ],
    "reRenderExpect": {
      "open": true,
      "count": 20
    }
  }
]
