From 5d1c2e9a7b3f4c6d8e0a1b2c3d4e5f60718293a4 Mon Sep 17 00:00:00 2001
From: Kitwork Dev <dev@kitwork.test>
Date: Mon, 12 Oct 2026 09:30:00 +0700
Subject: [PATCH] highlight: read shells, yaml and diffs on the server

Bộ tách từ cho bash, powershell, yaml và diff, để <code language="…">
không cần JavaScript trên trình duyệt.
---
 engine/jit/highlight/diff.go   | 12 ++++++++----
 engine/jit/highlight/legacy.go |  9 ---------
 2 files changed, 8 insertions(+), 13 deletions(-)

diff --git a/engine/jit/highlight/diff.go b/engine/jit/highlight/diff.go
index 4b825dc..7a3f0e1 100644
--- a/engine/jit/highlight/diff.go
+++ b/engine/jit/highlight/diff.go
@@ -1,12 +1,15 @@
 package highlight
 
-import "strings"
+import (
+	"strings"
+)
 
 // tokenizeDiff reads a unified diff line by line.
 func tokenizeDiff(scan *scanner) {
-	for !scan.done() {
-		scan.emitRest(Plain)
-	}
+	diff := &diffTokenizer{}
+	for loop := scan.loop(); loop.next(); {
+		diff.step(scan)
+	}
 }
 
 // diffHeaders start the lines that describe a file.
@@ -30,8 +33,9 @@ var diffHeaders = []string{"diff ", "index ", "--- ", "+++ "}
 func (diff *diffTokenizer) classify(line string) Kind {
 	switch {
 	case strings.HasPrefix(line, "@@"):
+		diff.oldLeft, diff.newLeft, diff.inHunk = diffHunkCounts(line)
 		return Heading
 	case line[0] == '+':
 		return Inserted
 	case line[0] == '-':
 		return Deleted
diff --git a/engine/jit/highlight/testdata/sql/orders.sql b/engine/jit/highlight/testdata/sql/orders.sql
index 1a2b3c4..5d6e7f8 100644
--- a/engine/jit/highlight/testdata/sql/orders.sql
+++ b/engine/jit/highlight/testdata/sql/orders.sql
@@ -2,7 +2,7 @@
 CREATE TABLE orders (
   id INTEGER PRIMARY KEY,
   site TEXT NOT NULL,
--- a comment that was a line of its own
+-- tổng tiền tính bằng đồng
   total INTEGER NOT NULL DEFAULT 0,
   created_at TEXT NOT NULL
 );
diff --git a/engine/jit/highlight/legacy.go b/engine/jit/highlight/legacy.go
deleted file mode 100644
index 9c1d2e3..0000000
--- a/engine/jit/highlight/legacy.go
+++ /dev/null
@@ -1,9 +0,0 @@
-package highlight
-
-// legacyNames maps the short names the first highlighter accepted.
-var legacyNames = map[string]string{
-	"js":     "javascript",
-	"golang": "go",
-	"sh":     "bash",
-	"yml":    "yaml",
-}
