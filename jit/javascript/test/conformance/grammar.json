[
  {
    "name": "Parse Named Map Grammar top-level colons and semicolons",
    "mode": "named_map",
    "input": "order: { id: 128, amount: 49.90 }; open: false;",
    "expected": {
      "order": "{ id: 128, amount: 49.90 }",
      "open": "false"
    }
  },
  {
    "name": "Reject assignments in Binding Expression Mode",
    "mode": "binding",
    "input": "count = count + 1",
    "expectError": "KIT_BINDING_ASSIGNMENT"
  },
  {
    "name": "Reject Promise in Binding Expression Mode",
    "mode": "binding",
    "input": "kit.request.get('/data')",
    "expectError": "KIT_ASYNC_BINDING"
  }
]
